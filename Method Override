class Animal {
  void speak() {
    print("Animal makes a sound");
  }
}


class Dog extends Animal {
  @override
  void speak() {
    print("Woof! Woof!");
  }
}

class Cat extends Animal {
  @override
  void speak() {
    print("Meow! Meow!");
  }
}

void main() {

  List<Animal> animals = [
    Dog(),
    Cat(),
    Dog(),
    Cat(),
    Dog()
  ];

 
  for (var animal in animals) {
    animal.speak();
  }
}
