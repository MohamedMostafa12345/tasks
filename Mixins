mixin Logger {
  void log(String msg) {
    print("[LOG]: $msg");
  }
}


mixin Printer {
  void printData(String data) {
    print("[DATA]: $data");
  }
}


class Report with Logger, Printer {
  void generateReport() {
    print("[REPORT]: Report generated successfully!");
  }
}

void main() {

  Report report = Report();


  report.log("Starting report");
  report.printData("Report data");
  report.generateReport();
}
